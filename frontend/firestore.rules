rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pinned to the single owner account (created 2026-08-08), not just "any authenticated
    // uid" — this app has no public sign-up UI, but Email/Password sign-in inherently exposes
    // a public accounts:signUp REST endpoint via the (intentionally public) web API key. Until
    // that's disabled in Firebase Console -> Authentication -> Settings, pinning here is what
    // actually stops a second account from writing (and racking up cost/quota) under its own
    // uid. See docs/standards/security.md's Auth section and the security review this project
    // ran on 2026-08-08.
    function isOwner() {
      return request.auth != null && request.auth.uid == 'INYOjbJUWXbzB7q31IRivvzadr22';
    }

    match /users/{uid} {
      allow read, write: if isOwner() && request.auth.uid == uid;

      // Acompanhamento (check-ins) module — docs/firestore-data-model.md sections 1.1/1.2.
      match /profile/{docId} {
        allow read, write: if isOwner() && request.auth.uid == uid;
      }

      match /checkins/{checkinId} {
        allow read, write: if isOwner() && request.auth.uid == uid;
      }

      // Treino module — docs/firestore-data-model.md sections 1.3/1.4/1.5.
      match /workoutDays/{dayId} {
        allow read, write: if isOwner() && request.auth.uid == uid;

        match /exercises/{exerciseId} {
          allow read, write: if isOwner() && request.auth.uid == uid;

          match /loadHistory/{loadEntryId} {
            allow read, write: if isOwner() && request.auth.uid == uid;
          }
        }
      }

      // Dieta module — docs/firestore-data-model.md section 1.7. Note: dietGoals/main has no
      // rule because it's never persisted (section 1.6) — TDEE/target calories/BMI/macros are
      // calculated in memory from profile/main on every render, so there is no collection to
      // protect.
      match /mealPlan/{mealId} {
        allow read, write: if isOwner() && request.auth.uid == uid;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
